{
 "name": "proyectopom",
 "version": "1.0.0",
 "main": "index.js",
 "scripts": {
   "clean:reports": "rimraf reports",
   "test": "cucumber-js",
   "test:dev": "cross-env ENV=dev cucumber-js",
   "test:smoke": "cucumber-js --tags @smoke",
   "test:chromium": "cross-env BROWSER=chromium cucumber-js",
   "test:firefox": "cross-env BROWSER=firefox cucumber-js",
   "test:webkit": "cross-env BROWSER=webkit cucumber-js",
   "test:formulario": "cucumber-js --tags @formulario",
   "test:elephant": "cucumber-js --tags @elephant",
   "test:browsers": "npm run clean:reports && npm-run-all --parallel test:chromium test:firefox test:webkit && npm run report",
   "report": "node generate-report.js"
 },
 "keywords": [],
 "author": "",
