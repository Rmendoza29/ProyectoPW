 "description": "",
 "devDependencies": {
   "@cucumber/cucumber": "^12.9.0",
   "@playwright/test": "^1.60.0",
   "@types/node": "^25.9.1",
   "cross-env": "^10.1.0",
   "dotenv": "^17.4.2",
   "multiple-cucumber-html-reporter": "^3.10.0",
   "npm-run-all": "^4.1.5",
   "playwright": "^1.60.0",
   "rimraf": "^6.1.3",
   "ts-node": "^10.9.2",
   "typescript": "^6.0.3"
 }
}
